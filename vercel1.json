{
  "version": 2,
  "builds": [
    {
      "src": "src/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/src/main.py"
    }
  ],
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "echo 'No build step needed'",
  "framework": null
}
